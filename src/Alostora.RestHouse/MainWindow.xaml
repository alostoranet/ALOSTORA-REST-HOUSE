AddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="اسم الفيديو" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="النوع" Binding="{Binding KindLabel}" Width="70"/><DataGridTextColumn Header="القسم" Binding="{Binding CategoryTitle}" Width="135"/><DataGridTextColumn Header="المشاهدات" Binding="{Binding ViewCount}" Width="85"/><DataGridTextColumn Header="البيانات" Binding="{Binding MetadataStatus}" Width="100"/><DataGridTextColumn Header="النشر" Binding="{Binding PublishStatus}" Width="70"/></DataGrid.Columns></DataGrid></DockPanel></Border></TabItem>
