<DataGrid.Columns>
<DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*"/>
<DataGridTextColumn Header="المكتبة" Binding="{Binding KindLabel}" Width="120"/>
<DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="180"/>
<DataGridTextColumn Header="الحجم" Binding="{Binding SizeLabel}" Width="110"/>
<DataGridTextColumn Header="آخر تعديل" Binding="{Binding ModifiedUtc}" Width="180"/>
</DataGrid.Columns>
</DataGrid>
</DockPanel>
</Border>
</TabItem></TabControl></TabItem>
<TabItem Header="🎬 المسلسلات والحلقات">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TabControl Grid.Row="0" Margin="0" Background="White">
<TabItem Header="بيانات المسلسل"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="إدارة المسلسلات والمواسم والحلقات" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,14"/>
<TextBlock Text="اختر مسلسلًا موجودًا أو اكتب بيانات مسلسل جديد."/>
<WrapPanel Margin="0,5,0,8"><Button Content="مسلسل جديد" Click="NewSeries_Click" Padding="10,7" Margin="0,0,6,0"/><Button Content="إنشاء مسلسل من الفيديو المحدد" Click="CreateSeriesFromVideo_Click" Padding="10,7" Margin="0,0,6,0"/></WrapPanel><TextBlock Text="سجل المسلسلات المضافة — اختر أي مسلسل لفتح بياناته وتعديلها" Foreground="#64748B" FontSize="12" Margin="0,0,0,6"/><DataGrid x:Name="SeriesPicker" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="SeriesPicker_SelectionChanged" CanUserAddRows="False" Height="145" Margin="0,0,0,10"><DataGrid.Columns><DataGridTextColumn Header="المسلسل" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="السنة" Binding="{Binding Year}" Width="60"/><DataGridTextColumn Header="القسم" Binding="{Binding CategoryTitle}" Width="105"/><DataGridTextColumn Header="التنظيم" Binding="{Binding OrganizationTypeLabel}" Width="95"/><DataGridTextColumn Header="النشر" Binding="{Binding PublishStatus}" Width="70"/></DataGrid.Columns></DataGrid>
