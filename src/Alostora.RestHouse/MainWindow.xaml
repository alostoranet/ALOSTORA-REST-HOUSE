<TextBlock Text="السنة"/><TextBox x:Name="SeriesYearBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="التصنيف"/><TextBox x:Name="SeriesGenreBox" Padding="8" Margin="0,4,0,8"/>
<TextBox x:Name="SeriesSectionBox" Visibility="Collapsed" Text="عام"/><TextBlock Text="طريقة تنظيم محتوى المسلسل"/><ComboBox x:Name="SeriesStructureBox" Padding="8" Margin="0,4,0,8" SelectionChanged="SeriesStructureBox_SelectionChanged"><ComboBoxItem Content="بدون مواسم أو أجزاء — فيديوهات مباشرة" Tag="None"/><ComboBoxItem Content="تنظيم بالمواسم" Tag="Seasons" IsSelected="True"/><ComboBoxItem Content="تنظيم بالأجزاء" Tag="Parts"/></ComboBox><TextBlock Text="اختر طريقة العرض التي تناسب هذا العمل. يمكنك تغييرها لاحقاً دون حذف ملفات الفيديو." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
