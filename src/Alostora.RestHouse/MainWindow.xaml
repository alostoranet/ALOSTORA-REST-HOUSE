 <StackPanel>
  <DockPanel Margin="0,0,0,8"><TextBlock x:Name="DashboardWatchHistoryStatus" Text="جارٍ تحميل سجل المشاهدة..." Foreground="#64748B" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="تحديث المشاهدات" Click="RefreshWatchHistory_Click" Padding="10,5"/></DockPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
