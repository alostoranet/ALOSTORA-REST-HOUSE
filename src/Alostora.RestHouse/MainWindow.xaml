<Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,10,0,0">
<StackPanel>
<TextBlock Text="هوية الاستراحة والشبكة" FontSize="17" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,6,8"><TextBlock Text="اسم الاستراحة"/><TextBox x:Name="RestHouseNameBox" Padding="8" Margin="0,4,0,0" Text="استراحة الأسطورة"/></StackPanel>
<StackPanel Grid.Column="1" Margin="6,0,0,8"><TextBlock Text="اسم الشبكة أو الجهة"/><TextBox x:Name="NetworkNameBox" Padding="8" Margin="0,4,0,0" Text="شبكة الأسطورة نت"/></StackPanel>
</Grid>
<DockPanel LastChildFill="True" Margin="0,0,0,5">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
<Image x:Name="BrandLogoPreview" Width="52" Height="52" Stretch="Uniform" Margin="0,0,8,0"/>
<Button Content="اختيار شعار أو صورة الشبكة" Click="ChooseBrandLogo_Click" Padding="12,8" Margin="0,0,6,0"/>
<Button Content="حفظ الهوية" Click="SaveBrandProfile_Click" Padding="14,8" Background="#C93640" Foreground="White" FontWeight="Bold"/>
</StackPanel>
<TextBox x:Name="BrandLogoPathBox" IsReadOnly="True" Padding="8" VerticalContentAlignment="Center" FlowDirection="LeftToRight" ToolTip="مسار صورة الهوية المحفوظة"/>
</DockPanel>
<TextBlock x:Name="BrandProfileStatusText" Text="يمكنك تخصيص اسم الاستراحة واسم الشبكة ورفع شعار يظهر للعملاء." Foreground="#64748B" TextWrapping="Wrap"/>
</StackPanel></Border>
<Grid Grid.Row="2" Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="سجل الفيديوهات وبياناتها" FontSize="18" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,10"/><WrapPanel HorizontalAlignment="Right" Margin="0,0,0,10"><Button Content="تحديث القائمة" Click="RefreshLibrary_Click" Padding="14,7" Margin="0,0,6,0"/><Button Content="تحديد الكل" Click="SelectAllVideos_Click" Padding="12,7" Margin="0,0,6,0"/><Button Content="إلغاء التحديد" Click="ClearVideoSelection_Click" Padding="12,7" Margin="0,0,6,0"/><Button Content="إزالة المحدد من المكتبة" Click="RemoveVideoFromLibrary_Click" Padding="14,7" Margin="0,0,6,0" Background="#E6F1FA" Foreground="#245B87"/><Button Content="حذف المحدد نهائياً من الجهاز" Click="DeleteVideo_Click" Padding="14,7" Margin="0,0,6,0" Background="#FCE8E8" Foreground="#9F2630"/><Button Content="إضافة ملفات فيديو من الجهاز" Click="AddVideoFiles_Click" Padding="14,7" Margin="0,0,6,0" Background="#E7F5EC" Foreground="#176B3A"/><Button Content="إضافة مجلد فيديو خارجي" Click="AddExternalMediaFolder_Click" Padding="14,7"/></WrapPanel></StackPanel><DataGrid x:Name="VideosGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="VideosGrid_SelectionChanged" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="اسم الفيديو" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="النوع" Binding="{Binding KindLabel}" Width="70"/><DataGridTextColumn Header="القسم" Binding="{Binding CategoryTitle}" Width="135"/><DataGridTextColumn Header="المشاهدات" Binding="{Binding ViewCount}" Width="85"/><DataGridTextColumn Header="البيانات" Binding="{Binding MetadataStatus}" Width="100"/><DataGridTextColumn Header="النشر" Binding="{Binding PublishStatus}" Width="70"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18" Margin="8,0,0,0"><TabControl><TabItem Header="بيانات الفيديو"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="بيانات الفيلم أو المسلسل" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,14"/>
<TextBlock Text="العنوان"/><TextBox x:Name="TitleBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="الوصف"/><TextBox x:Name="DescriptionBox" Padding="8" Margin="0,4,0,10" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<TextBlock Text="سنة الإنتاج"/><TextBox x:Name="YearBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="التصنيف (أكشن، كوميدي...)"/><TextBox x:Name="GenreBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="المخرج"/><TextBox x:Name="DirectorBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="طاقم التمثيل (افصل بين الأسماء بفاصلة)"/><TextBox x:Name="CastBox" Padding="8" Margin="0,4,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,5,8"><TextBlock Text="التقييم من 10"/><TextBox x:Name="RatingBox" Padding="8" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,8"><TextBlock Text="المدة بالدقائق"/><TextBox x:Name="RuntimeBox" Padding="8" Margin="0,4,0,0"/></StackPanel></Grid>
<TextBlock Text="تاريخ الإصدار (YYYY-MM-DD)"/><TextBox x:Name="ReleaseDateBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="وسوم إضافية"/><TextBox x:Name="TagsBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="قسم العرض النصي (اختياري)"/><TextBox x:Name="SectionBox" Padding="8" Margin="0,4,0,10" Text="عام"/>
<TextBlock Text="القسم الرئيسي"/><ComboBox x:Name="VideoMainCategoryPicker" DisplayMemberPath="Title" SelectedValuePath="CategoryId" SelectionChanged="VideoMainCategoryPicker_SelectionChanged" Padding="8" Margin="0,4,0,3"/><TextBlock Text="القسم الفرعي الذي سيظهر فيه العمل"/><ComboBox x:Name="VideoCategoryPicker" DisplayMemberPath="DisplayTitle" SelectedValuePath="CategoryId" Padding="8" Margin="0,4,0,3"/><TextBlock x:Name="VideoCategoryStatusText" Text="اختر نوع المحتوى أولاً لعرض الأقسام الفرعية المناسبة." Foreground="#64748B" FontSize="11" Margin="0,0,0,9"/><Separator/><TextBlock Text="ربط الفيديو ببرنامج أو مسلسل (اختياري)" FontWeight="Bold" Foreground="#142D4A" Margin="0,8,0,5"/><TextBlock Text="المسلسل أو البرنامج"/><ComboBox x:Name="VideoSeriesPicker" DisplayMemberPath="Title" SelectedValuePath="SeriesId" SelectionChanged="VideoSeriesPicker_SelectionChanged" Padding="8" Margin="0,4,0,5"/><TextBlock Text="الموسم أو الجزء — اتركه فارغاً لربط الفيديو بالمسلسل مباشرة"/><ComboBox x:Name="VideoSeasonPicker" DisplayMemberPath="DisplayTitle" SelectedValuePath="SeasonId" Padding="8" Margin="0,4,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,5,8"><TextBlock Text="رقم الحلقة"/><TextBox x:Name="VideoEpisodeNumberBox" Padding="8" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,8"><TextBlock Text="اسم الحلقة (اختياري)"/><TextBox x:Name="VideoEpisodeTitleBox" Padding="8" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock x:Name="VideoPlacementStatusText" Text="يمكنك ربط الفيديو بمسلسل مباشرة أو بموسم/جزء محدد." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>
<CheckBox x:Name="PublishBox" Content="نشر هذا العمل في واجهة العميل (بعد اختيار القسم)" IsChecked="True" Margin="0,0,0,12" FontWeight="Bold" Foreground="#16834A"/>
<TextBlock Text="نوع المحتوى"/><ComboBox x:Name="KindBox" Padding="7" Margin="0,4,0,10" SelectionChanged="KindBox_SelectionChanged"><ComboBoxItem Content="فيلم" Tag="Movie" IsSelected="True"/><ComboBoxItem Content="مسلسل" Tag="Series"/></ComboBox>
<TextBlock Text="معرّف الملف" Foreground="#64748B"/><TextBox x:Name="IdBox" IsReadOnly="True" Padding="8" Margin="0,4,0,14" FlowDirection="LeftToRight"/>
