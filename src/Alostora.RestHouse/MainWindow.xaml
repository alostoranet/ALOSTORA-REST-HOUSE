<Window Icon="Assets/alostora.ico" x:Class="Alostora.RestHouse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALOSTORA REST HOUSE" Height="760" Width="1120" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FlowDirection="RightToLeft">
<Window.Resources>
 <Style TargetType="{x:Type Button}">
  <Setter Property="Padding" Value="11,7"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="#193653"/>
  <Setter Property="Background" Value="#E6EDF5"/>
  <Setter Property="BorderBrush" Value="#D2DCE8"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type Button}">
     <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="{x:Type TextBox}">
  <Setter Property="Padding" Value="8"/>
  <Setter Property="BorderBrush" Value="#CBD5E1"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Background" Value="#FFFFFF"/>
  <Setter Property="Foreground" Value="#1E293B"/>
  <Setter Property="FontSize" Value="13"/>
 </Style>
 <Style TargetType="{x:Type CheckBox}">
  <Setter Property="Foreground" Value="#334155"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style TargetType="{x:Type ComboBox}">
  <Setter Property="Padding" Value="8"/>
  <Setter Property="Background" Value="#FFFFFF"/>
  <Setter Property="Foreground" Value="#1E293B"/>
  <Setter Property="BorderBrush" Value="#CBD5E1"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontSize" Value="13"/>
 </Style>
 <Style TargetType="{x:Type ScrollViewer}">
  <Setter Property="Margin" Value="4"/>
  <Setter Property="Padding" Value="8"/>
 </Style>
 <Style TargetType="{x:Type DataGrid}">
  <Setter Property="RowBackground" Value="#FFFFFF"/>
  <Setter Property="AlternatingRowBackground" Value="#F3F7FB"/>
  <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
  <Setter Property="BorderBrush" Value="#D8E1EB"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Margin" Value="3"/>
  <Setter Property="CanUserResizeRows" Value="False"/>
  <Setter Property="FontSize" Value="12"/>
 </Style>
</Window.Resources>
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#142D4A" CornerRadius="12" Padding="18"><DockPanel LastChildFill="True"><Button DockPanel.Dock="Left" Content="التحديثات" Click="Updates_Click" Padding="14,9" Margin="0,0,10,0" Background="#D6AD58" Foreground="#142D4A" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center"/><Button DockPanel.Dock="Left" Content="السماح بالوصول من الشبكة" Click="EnableFirewall_Click" Padding="14,9" Margin="0,0,10,0" Background="#DCEBFA" Foreground="#142D4A" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/alostora.ico" Width="48" Height="48" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="ALOSTORA REST HOUSE" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="استراحة الأسطورة نت | إدارة خدمات الاستراحة" Foreground="#D7E5F3" FontSize="15" Margin="0,6,0,0"/></StackPanel></StackPanel></DockPanel></Border>

<TabControl x:Name="MainNavigationTabs" Grid.Row="1" Margin="0,14" Background="#F3F6FA" TabStripPlacement="Left" BorderThickness="0">
<TabControl.ItemContainerStyle>
<Style TargetType="{x:Type TabItem}">
<Setter Property="Width" Value="184"/>
<Setter Property="Padding" Value="12,14"/>
<Setter Property="Margin" Value="0,0,0,6"/>
<Setter Property="Background" Value="#E8EEF5"/>
<Setter Property="Foreground" Value="#334155"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="VerticalContentAlignment" Value="Center"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="{x:Type TabItem}">
<Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
<ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#142D4A"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#C93640"/><Setter Property="Foreground" Value="White"/></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</TabControl.ItemContainerStyle>
<TabItem Header="🏠 لوحة التحكم">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<Border Background="#142D4A" CornerRadius="12" Padding="22" Margin="0,0,0,14">
 <StackPanel><TextBlock Text="مركز إدارة الاستراحة" Foreground="White" FontSize="22" FontWeight="Bold"/>
 <TextBlock Text="إدارة المحتوى وخدمات العملاء وهوية الاستراحة وإعدادات التشغيل من لوحة واحدة. الأرقام تُحمّل من بيانات البرنامج الفعلية." Foreground="#D7E5F3" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
</Border>
<TabControl x:Name="DashboardSectionsTabs" TabStripPlacement="Top" Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
