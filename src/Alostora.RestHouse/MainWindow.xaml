     <DataGrid.Columns><DataGridTextColumn Header="الفيديو" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="مرات التشغيل" Binding="{Binding PlayCount}" Width="95"/></DataGrid.Columns>
    </DataGrid>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="6,0,0,0">
    <TextBlock Text="آخر المشاهدات" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,6"/>
    <DataGrid x:Name="DashboardRecentGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Height="190">
     <DataGrid.Columns><DataGridTextColumn Header="الفيديو" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="وقت التشغيل" Binding="{Binding StartedLocal}" Width="130"/></DataGrid.Columns>
    </DataGrid>
   </StackPanel>
  </Grid>
 </StackPanel>
</Border></StackPanel></TabItem>
 <TabItem Header="📚 إدارة المحتوى"><StackPanel><TextBlock Text="إدارة المحتوى" FontSize="18" FontWeight="Bold" Foreground="#142D4A" Margin="2,0,0,8"/><UniformGrid Columns="2" Rows="5" Margin="0,0,0,12">
