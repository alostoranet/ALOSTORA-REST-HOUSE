<Window x:Class="Alostora.RestHouse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALOSTORA REST HOUSE" Height="760" Width="1120" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FlowDirection="RightToLeft">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#142D4A" CornerRadius="12" Padding="18"><DockPanel LastChildFill="True"><Button DockPanel.Dock="Left" Content="السماح بالوصول من الشبكة" Click="EnableFirewall_Click" Padding="14,9" Margin="0,0,10,0" Background="#DCEBFA" Foreground="#142D4A" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center"/><Button DockPanel.Dock="Left" Content="إنشاء نسخة احتياطية" Click="CreateBackup_Click" Padding="14,9" Margin="16,0,0,0" Background="#FFFFFF" Foreground="#142D4A" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center"/><Button DockPanel.Dock="Left" Content="استعادة نسخة احتياطية" Click="RestoreBackup_Click" Padding="14,9" Margin="8,0,0,0" Background="#FCE8E8" Foreground="#9F2630" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="ALOSTORA REST HOUSE" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="استراحة الأسطورة نت | إدارة مكتبة الأفلام" Foreground="#D7E5F3" FontSize="15" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>

<TabControl x:Name="MainNavigationTabs" Grid.Row="1" Margin="0,14" Background="#F3F6FA" TabStripPlacement="Left" BorderThickness="0">
<TabControl.ItemContainerStyle>
<Style TargetType="{x:Type TabItem}">
<Setter Property="Width" Value="184"/>
<Setter Property="Padding" Value="12,14"/>
<Setter Property="Margin" Value="0,0,0,6"/>
<Setter Property="Background" Value="#E8EEF5"/>
<Setter Property="Foreground" Value="#334155"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="VerticalContentAlignment" Value="Center"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="{x:Type TabItem}">
<Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
<ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#142D4A"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#C93640"/><Setter Property="Foreground" Value="White"/></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</TabControl.ItemContainerStyle>
<TabItem Header="🏠 لوحة التحكم">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<Border Background="#142D4A" CornerRadius="12" Padding="22" Margin="0,0,0,14">
 <StackPanel><TextBlock Text="مرحباً بك في إدارة استراحة الأسطورة" Foreground="White" FontSize="22" FontWeight="Bold"/>
 <TextBlock Text="تم تنظيم أدوات الإدارة إلى مساحات واضحة. اختر المهمة من القائمة الجانبية، ثم استخدم خطوات العمل داخل كل مساحة." Foreground="#D7E5F3" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
</Border>
<UniformGrid Columns="2" Rows="3" Margin="0,0,0,12">
 <Border Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="4" Tag="1" Cursor="Hand" ToolTip="اضغط لفتح مكتبة الفيديوهات" MouseLeftButtonUp="DashboardCard_Click"><StackPanel><TextBlock Text="١. مكتبة الفيديوهات" FontWeight="Bold" FontSize="16" Foreground="#142D4A"/><TextBlock Text="استعراض المجلدات والملفات وإضافة الفيديوهات أو إزالتها من المكتبة." TextWrapping="Wrap" Foreground="#526174" Margin="0,7,0,0"/></StackPanel></Border>
 <Border Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="4" Tag="1" Cursor="Hand" ToolTip="اضغط لفتح بيانات الفيديو" MouseLeftButtonUp="DashboardCard_Click"><StackPanel><TextBlock Text="٢. بيانات الفيديو" FontWeight="Bold" FontSize="16" Foreground="#142D4A"/><TextBlock Text="تعديل العنوان والوصف والغلاف وربط العمل بقسم أو مسلسل عند الحاجة." TextWrapping="Wrap" Foreground="#526174" Margin="0,7,0,0"/></StackPanel></Border>
 <Border Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="4" Tag="2" Cursor="Hand" ToolTip="اضغط لإدارة المسلسلات والمواسم والحلقات" MouseLeftButtonUp="DashboardCard_Click"><StackPanel><TextBlock Text="٣. المسلسلات والبرامج" FontWeight="Bold" FontSize="16" Foreground="#142D4A"/><TextBlock Text="إنشاء العمل، تحديد طريقة تنظيمه، ربطه بالقسم، ثم إضافة المواسم والحلقات." TextWrapping="Wrap" Foreground="#526174" Margin="0,7,0,0"/></StackPanel></Border>
 <Border Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="4" Tag="3" Cursor="Hand" ToolTip="اضغط لإدارة الأقسام والتصنيفات" MouseLeftButtonUp="DashboardCard_Click"><StackPanel><TextBlock Text="٤. الأقسام" FontWeight="Bold" FontSize="16" Foreground="#142D4A"/><TextBlock Text="أنشئ القسم الرئيسي أولاً، ثم أضف الأقسام الفرعية التابعة له وحدد نوع محتواها." TextWrapping="Wrap" Foreground="#526174" Margin="0,7,0,0"/></StackPanel></Border>
 <Border Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="4" Tag="4" Cursor="Hand" ToolTip="اضغط لفتح رسائل العملاء والبلاغات" MouseLeftButtonUp="DashboardCard_Click"><StackPanel><TextBlock Text="٥. رسائل العملاء والبلاغات" FontWeight="Bold" FontSize="16" Foreground="#142D4A"/><TextBlock Text="راجع استفسارات العملاء والبلاغات من مساحة واحدة." TextWrapping="Wrap" Foreground="#526174" Margin="0,7,0,0"/></StackPanel></Border>
 <Border Background="#F1F5F9" CornerRadius="10" Padding="16" Margin="4" Tag="5" Cursor="Hand" ToolTip="اضغط لفتح إعدادات الاستراحة" MouseLeftButtonUp="DashboardCard_Click"><StackPanel><TextBlock Text="٦. إعدادات الاستراحة" FontWeight="Bold" FontSize="16" Foreground="#142D4A"/><TextBlock Text="إدارة الهوية والشعار ومسارات المكتبة والنسخ الاحتياطي وأدوات التشغيل." TextWrapping="Wrap" Foreground="#526174" Margin="0,7,0,0"/></StackPanel></Border>
</UniformGrid>
<Border Background="#FFF7E8" CornerRadius="9" Padding="12"><TextBlock Text="تنبيه للحفاظ على بياناتك: إزالة فيديو من المكتبة لا تعني حذف الملف الأصلي. خيار الحذف النهائي منفصل ويطلب تأكيداً. احتفظ بنسخة احتياطية قبل العمليات الكبيرة." Foreground="#80551A" TextWrapping="Wrap"/></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="📚 إدارة المكتبة"><TabControl Margin="0" Background="White"><TabItem Header="📁 مكتبة الفيديوهات"><Border Background="White" CornerRadius="10" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="سجل الفيديوهات وبياناتها" FontSize="18" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,10"/><WrapPanel HorizontalAlignment="Right" Margin="0,0,0,10"><Button Content="تحديث القائمة" Click="RefreshLibrary_Click" Padding="14,7" Margin="0,0,6,0"/><Button Content="تحديد الكل" Click="SelectAllVideos_Click" Padding="12,7" Margin="0,0,6,0"/><Button Content="إلغاء التحديد" Click="ClearVideoSelection_Click" Padding="12,7" Margin="0,0,6,0"/><Button Content="إزالة المحدد من المكتبة" Click="RemoveVideoFromLibrary_Click" Padding="14,7" Margin="0,0,6,0" Background="#E6F1FA" Foreground="#245B87"/><Button Content="حذف المحدد نهائياً من الجهاز" Click="DeleteVideo_Click" Padding="14,7" Margin="0,0,6,0" Background="#FCE8E8" Foreground="#9F2630"/><Button Content="إضافة ملفات فيديو من الجهاز" Click="AddVideoFiles_Click" Padding="14,7" Margin="0,0,6,0" Background="#E7F5EC" Foreground="#176B3A"/><Button Content="إضافة مجلد فيديو خارجي" Click="AddExternalMediaFolder_Click" Padding="14,7" Margin="0,0,6,0"/><Button Content="إنشاء مجلد جديد" Click="CreateLibraryFolder_Click" Padding="14,7" Margin="0,0,6,0"/><Button Content="فتح المجلد المحدد" Click="OpenLibraryFolder_Click" Padding="14,7" Margin="0,0,6,0"/><Button Content="نسخ المحدد إلى المجلد" Click="CopyVideosToSelectedFolder_Click" Padding="14,7"/></WrapPanel></StackPanel><TextBlock Text="مجلدات المكتبة — اختر مجلداً لعرض الفيديوهات الموجودة بداخله" Foreground="#526174" FontSize="12" Margin="0,0,0,5"/><TreeView x:Name="VideoFoldersTree" Height="125" SelectedItemChanged="VideoFoldersTree_SelectedItemChanged" Margin="0,0,0,10"/><DataGrid x:Name="VideosGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="VideosGrid_SelectionChanged" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="اسم الفيديو" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="النوع" Binding="{Binding KindLabel}" Width="70"/><DataGridTextColumn Header="القسم" Binding="{Binding CategoryTitle}" Width="135"/><DataGridTextColumn Header="المشاهدات" Binding="{Binding ViewCount}" Width="85"/><DataGridTextColumn Header="البيانات" Binding="{Binding MetadataStatus}" Width="100"/><DataGridTextColumn Header="النشر" Binding="{Binding PublishStatus}" Width="70"/></DataGrid.Columns></DataGrid></DockPanel></Border></TabItem>
<TabItem Header="✏️ بيانات الفيديو"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="بيانات الفيلم أو المسلسل" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,14"/>
<TextBlock Text="العنوان"/><TextBox x:Name="TitleBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="الوصف"/><TextBox x:Name="DescriptionBox" Padding="8" Margin="0,4,0,10" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<TextBlock Text="سنة الإنتاج"/><TextBox x:Name="YearBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="التصنيف (أكشن، كوميدي...)"/><TextBox x:Name="GenreBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="المخرج"/><TextBox x:Name="DirectorBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="طاقم التمثيل (افصل بين الأسماء بفاصلة)"/><TextBox x:Name="CastBox" Padding="8" Margin="0,4,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,5,8"><TextBlock Text="التقييم من 10"/><TextBox x:Name="RatingBox" Padding="8" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,8"><TextBlock Text="المدة بالدقائق"/><TextBox x:Name="RuntimeBox" Padding="8" Margin="0,4,0,0"/></StackPanel></Grid>
<TextBlock Text="تاريخ الإصدار (YYYY-MM-DD)"/><TextBox x:Name="ReleaseDateBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="وسوم إضافية"/><TextBox x:Name="TagsBox" Padding="8" Margin="0,4,0,10"/>
<TextBox x:Name="SectionBox" Visibility="Collapsed" Text="عام"/>
<TextBlock Text="القسم الرئيسي"/><ComboBox x:Name="VideoMainCategoryPicker" DisplayMemberPath="Title" SelectedValuePath="CategoryId" SelectionChanged="VideoMainCategoryPicker_SelectionChanged" Padding="8" Margin="0,4,0,3"/><TextBlock Text="القسم الفرعي الذي سيظهر فيه العمل"/><ComboBox x:Name="VideoCategoryPicker" DisplayMemberPath="DisplayTitle" SelectedValuePath="CategoryId" Padding="8" Margin="0,4,0,3"/><TextBlock x:Name="VideoCategoryStatusText" Text="اختر نوع المحتوى أولاً لعرض الأقسام الفرعية المناسبة." Foreground="#64748B" FontSize="11" Margin="0,0,0,9"/><Separator/><TextBlock Text="ربط اختياري ببرنامج أو مسلسل" FontWeight="Bold" Foreground="#142D4A" Margin="0,8,0,5"/><TextBlock Text="اترك هذا الاختيار فارغاً للفيديو المستقل. إذا كان الفيديو تابعاً لمسلسل أو برنامج، اختره هنا ليظهر في مكانه الصحيح عند العميل." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock Text="المسلسل أو البرنامج"/><ComboBox x:Name="VideoSeriesPicker" DisplayMemberPath="Title" SelectedValuePath="SeriesId" SelectionChanged="VideoSeriesPicker_SelectionChanged" Padding="8" Margin="0,4,0,5"/><TextBlock Text="الموسم أو الجزء — اتركه فارغاً لربط الفيديو بالمسلسل مباشرة"/><ComboBox x:Name="VideoSeasonPicker" DisplayMemberPath="DisplayTitle" SelectedValuePath="SeasonId" Padding="8" Margin="0,4,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,5,8"><TextBlock Text="رقم الحلقة"/><TextBox x:Name="VideoEpisodeNumberBox" Padding="8" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,8"><TextBlock Text="اسم الحلقة (اختياري)"/><TextBox x:Name="VideoEpisodeTitleBox" Padding="8" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock x:Name="VideoPlacementStatusText" Text="يمكنك ربط الفيديو بمسلسل مباشرة أو بموسم/جزء محدد." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>
<CheckBox x:Name="PublishBox" Content="نشر هذا العمل في واجهة العميل (بعد اختيار القسم)" IsChecked="True" Margin="0,0,0,12" FontWeight="Bold" Foreground="#16834A"/>
<TextBlock Text="نوع المحتوى"/><ComboBox x:Name="KindBox" Padding="7" Margin="0,4,0,10" SelectionChanged="KindBox_SelectionChanged"><ComboBoxItem Content="فيلم" Tag="Movie" IsSelected="True"/><ComboBoxItem Content="مسلسل" Tag="Series"/></ComboBox>
<TextBlock Text="معرّف الملف" Foreground="#64748B"/><TextBox x:Name="IdBox" IsReadOnly="True" Padding="8" Margin="0,4,0,14" FlowDirection="LeftToRight"/>
<Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock Text="غلاف الفيلم أو المسلسل (اختياري)" FontWeight="Bold" Foreground="#142D4A"/><TextBlock x:Name="PosterStatusText" Text="لم يتم اختيار غلاف جديد." Foreground="#64748B" Margin="0,5,0,8" TextWrapping="Wrap"/><Button Content="اختيار ورفع الغلاف" Click="UploadPoster_Click" Padding="12,8" HorizontalAlignment="Right" Background="#245B87" Foreground="White" BorderThickness="0"/></StackPanel></Border>
<Button Content="حفظ البيانات" Click="SaveMetadata_Click" Background="#C93640" Foreground="White" FontWeight="Bold" Padding="14,11" BorderThickness="0"/>
<TextBlock x:Name="StatusText" Text="اختر فيديو من القائمة لتعديل بياناته." Foreground="#526174" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="🎧 الصوتيات والكتب والتطبيقات">
<Border Background="White" CornerRadius="10" Padding="16">
<DockPanel>
<StackPanel DockPanel.Dock="Top">
<TextBlock Text="إدارة المكتبات الإضافية" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,8"/>
<TextBlock Text="أضف ملفاتك إلى المجلدات Audio وBooks وApps داخل مجلد مكتبة الاستراحة، ثم اضغط فحص المكتبة. الفحص يسجل الملفات دون نقلها أو حذفها." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>
