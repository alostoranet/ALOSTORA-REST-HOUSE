<Window x:Class="Alostora.RestHouse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALOSTORA REST HOUSE" Height="760" Width="1120" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FlowDirection="RightToLeft">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#142D4A" CornerRadius="12" Padding="18"><DockPanel LastChildFill="True"><Button DockPanel.Dock="Left" Content="السماح بالوصول من الشبكة" Click="EnableFirewall_Click" Padding="14,9" Margin="0,0,10,0" Background="#DCEBFA" Foreground="#142D4A" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center"/><Button DockPanel.Dock="Left" Content="إنشاء نسخة احتياطية" Click="CreateBackup_Click" Padding="14,9" Margin="16,0,0,0" Background="#FFFFFF" Foreground="#142D4A" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center"/><Button DockPanel.Dock="Left" Content="استعادة نسخة احتياطية" Click="RestoreBackup_Click" Padding="14,9" Margin="8,0,0,0" Background="#FCE8E8" Foreground="#9F2630" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="ALOSTORA REST HOUSE" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="استراحة الأسطورة نت | إدارة مكتبة الأفلام" Foreground="#D7E5F3" FontSize="15" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
<Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,10,0,0">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"><DockPanel><TextBlock Text="مجلد الأفلام والمسلسلات" FontWeight="Bold" Foreground="#142D4A" VerticalAlignment="Center"/><Button DockPanel.Dock="Left" Content="اختيار المجلد" Click="ChooseMediaFolder_Click" Padding="10,6" Margin="8,0,0,0"/></DockPanel><TextBlock x:Name="MediaFolderBox" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"><DockPanel><TextBlock Text="مجلد أغلفة الأفلام والمسلسلات" FontWeight="Bold" Foreground="#142D4A" VerticalAlignment="Center"/><Button DockPanel.Dock="Left" Content="اختيار المجلد" Click="ChoosePostersFolder_Click" Padding="10,6" Margin="8,0,0,0"/></DockPanel><TextBlock x:Name="PostersFolderBox" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"><TextBlock Text="محرك تشغيل الصيغ المتقدمة (FFmpeg)" FontWeight="Bold" Foreground="#142D4A"/><DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Left" Content="اختيار ffmpeg.exe" Click="ChooseFfmpeg_Click" Padding="10,6" Margin="0,0,6,0"/><Button DockPanel.Dock="Left" Content="حفظ المسار" Click="SaveFfmpeg_Click" Padding="10,6" Margin="0,0,6,0"/><TextBox x:Name="FfmpegPathBox" Padding="7" FlowDirection="LeftToRight" VerticalContentAlignment="Center"/></DockPanel><TextBlock x:Name="FfmpegStatusText" Text="ضع ffmpeg.exe وffprobe.exe في المجلد نفسه، ثم أعد تشغيل البرنامج." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Row="2" Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="ملفات الفيديو في المكتبة" FontSize="18" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,10"/><WrapPanel HorizontalAlignment="Right" Margin="0,0,0,10"><Button Content="تحديث القائمة" Click="RefreshLibrary_Click" Padding="14,7" Margin="0,0,6,0"/><Button Content="تحديد الكل" Click="SelectAllVideos_Click" Padding="12,7" Margin="0,0,6,0"/><Button Content="إلغاء التحديد" Click="ClearVideoSelection_Click" Padding="12,7" Margin="0,0,6,0"/><Button Content="إزالة المحدد من المكتبة" Click="RemoveVideoFromLibrary_Click" Padding="14,7" Margin="0,0,6,0" Background="#E6F1FA" Foreground="#245B87"/><Button Content="حذف المحدد نهائياً من الجهاز" Click="DeleteVideo_Click" Padding="14,7" Margin="0,0,6,0" Background="#FCE8E8" Foreground="#9F2630"/><Button Content="إضافة مجلد فيديو خارجي" Click="AddExternalMediaFolder_Click" Padding="14,7"/></WrapPanel></StackPanel><DataGrid x:Name="VideosGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="VideosGrid_SelectionChanged" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="اسم الفيديو" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="السنة" Binding="{Binding Year}" Width="65"/><DataGridTextColumn Header="النوع" Binding="{Binding Kind}" Width="85"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18" Margin="8,0,0,0"><TabControl><TabItem Header="بيانات الفيديو"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="بيانات الفيلم أو المسلسل" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,14"/>
<TextBlock Text="العنوان"/><TextBox x:Name="TitleBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="الوصف"/><TextBox x:Name="DescriptionBox" Padding="8" Margin="0,4,0,10" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<TextBlock Text="سنة الإنتاج"/><TextBox x:Name="YearBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="التصنيف (أكشن، كوميدي...)"/><TextBox x:Name="GenreBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="المخرج"/><TextBox x:Name="DirectorBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="طاقم التمثيل (افصل بين الأسماء بفاصلة)"/><TextBox x:Name="CastBox" Padding="8" Margin="0,4,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,5,8"><TextBlock Text="التقييم من 10"/><TextBox x:Name="RatingBox" Padding="8" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,8"><TextBlock Text="المدة بالدقائق"/><TextBox x:Name="RuntimeBox" Padding="8" Margin="0,4,0,0"/></StackPanel></Grid>
<TextBlock Text="تاريخ الإصدار (YYYY-MM-DD)"/><TextBox x:Name="ReleaseDateBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="وسوم إضافية"/><TextBox x:Name="TagsBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="قسم العرض النصي (اختياري)"/><TextBox x:Name="SectionBox" Padding="8" Margin="0,4,0,10" Text="عام"/>
<TextBlock Text="التصنيف الفرعي الذي سيظهر فيه العمل"/><ComboBox x:Name="VideoCategoryPicker" DisplayMemberPath="DisplayTitle" SelectedValuePath="CategoryId" Padding="8" Margin="0,4,0,10"/>
<CheckBox x:Name="PublishBox" Content="نشر هذا العمل في واجهة العميل" IsChecked="False" Margin="0,0,0,12" FontWeight="Bold" Foreground="#16834A"/>
<TextBlock Text="نوع المحتوى"/><ComboBox x:Name="KindBox" Padding="7" Margin="0,4,0,10"><ComboBoxItem Content="فيلم" Tag="Movie" IsSelected="True"/><ComboBoxItem Content="مسلسل" Tag="Series"/></ComboBox>
<TextBlock Text="معرّف الملف" Foreground="#64748B"/><TextBox x:Name="IdBox" IsReadOnly="True" Padding="8" Margin="0,4,0,14" FlowDirection="LeftToRight"/>
<Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,12"><StackPanel><TextBlock Text="غلاف الفيلم أو المسلسل" FontWeight="Bold" Foreground="#142D4A"/><TextBlock x:Name="PosterStatusText" Text="لم يتم اختيار غلاف جديد." Foreground="#64748B" Margin="0,5,0,8" TextWrapping="Wrap"/><Button Content="اختيار ورفع الغلاف" Click="UploadPoster_Click" Padding="12,8" HorizontalAlignment="Right" Background="#245B87" Foreground="White" BorderThickness="0"/></StackPanel></Border>
<Button Content="حفظ البيانات" Click="SaveMetadata_Click" Background="#C93640" Foreground="White" FontWeight="Bold" Padding="14,11" BorderThickness="0"/>
<TextBlock x:Name="StatusText" Text="اختر فيديو من القائمة لتعديل بياناته." Foreground="#526174" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="إدارة المسلسلات"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="إدارة المسلسلات والمواسم والحلقات" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,14"/>
<TextBlock Text="اختر مسلسلًا موجودًا أو اكتب بيانات مسلسل جديد."/>
<DockPanel Margin="0,5,0,10"><Button DockPanel.Dock="Left" Content="إنشاء مسلسل من الفيديو المحدد" Click="CreateSeriesFromVideo_Click" Padding="10,7" Margin="0,0,6,0"/><ComboBox x:Name="SeriesPicker" DisplayMemberPath="Title" SelectionChanged="SeriesPicker_SelectionChanged" Padding="8" /></DockPanel>
<TextBlock Text="معرّف المسلسل (اتركه فارغًا لإنشاء معرّف تلقائي)"/><TextBox x:Name="SeriesIdBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="اسم المسلسل"/><TextBox x:Name="SeriesTitleBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="الوصف"/><TextBox x:Name="SeriesDescriptionBox" Padding="8" Margin="0,4,0,8" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/>
<TextBlock Text="السنة"/><TextBox x:Name="SeriesYearBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="التصنيف"/><TextBox x:Name="SeriesGenreBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="قسم العرض النصي (اختياري)"/><TextBox x:Name="SeriesSectionBox" Padding="8" Margin="0,4,0,8" Text="عام"/>
<TextBlock Text="تصنيف المسلسل"/><ComboBox x:Name="SeriesCategoryPicker" DisplayMemberPath="DisplayTitle" SelectedValuePath="CategoryId" Padding="8" Margin="0,4,0,8"/>
<CheckBox x:Name="SeriesPublishBox" Content="نشر المسلسل في واجهة العميل" IsChecked="False" Margin="0,0,0,10" FontWeight="Bold" Foreground="#16834A"/>
<TextBlock Text="مجلد ملفات المسلسل (اختياري)"/><DockPanel Margin="0,4,0,8"><Button DockPanel.Dock="Left" Content="اختيار مجلد" Click="ChooseSeriesFolder_Click" Padding="10,6" Margin="6,0,0,0"/><TextBox x:Name="SeriesFolderPathBox" Padding="8" FlowDirection="LeftToRight"/></DockPanel>
<TextBlock Text="مسار الغلاف (اختياري)"/><TextBox x:Name="SeriesPosterPathBox" Padding="8" Margin="0,4,0,8"/><Button Content="اختيار ورفع غلاف المسلسل" Click="UploadSeriesPoster_Click" Padding="10,8" HorizontalAlignment="Right" Margin="0,0,0,10"/>
<WrapPanel Margin="0,3,0,14"><Button Content="حفظ بيانات المسلسل" Click="SaveSeries_Click" Background="#C93640" Foreground="White" FontWeight="Bold" Padding="12,9" BorderThickness="0" Margin="0,0,6,0"/><Button Content="حذف المسلسل وبياناته" Click="DeleteSeries_Click" Background="#FCE8E8" Foreground="#9F2630" Padding="12,9" BorderThickness="0"/></WrapPanel>
<Separator/>
<TextBlock Text="المواسم" FontSize="17" FontWeight="Bold" Foreground="#142D4A" Margin="0,12,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,6,8"><TextBox x:Name="SeasonTitleBox" Padding="8" Margin="0,0,0,5" ToolTip="اسم الموسم (اختياري)"/><DockPanel><Button DockPanel.Dock="Left" Content="مجلد الموسم" Click="ChooseSeasonFolder_Click" Padding="8,5" Margin="0,0,5,0"/><TextBox x:Name="SeasonFolderPathBox" Padding="7" FlowDirection="LeftToRight" ToolTip="مسار مجلد ملفات هذا الموسم"/></DockPanel></StackPanel>
<TextBox x:Name="SeasonNumberBox" Grid.Column="1" Padding="8" Margin="0,0,0,8" Text="1" ToolTip="رقم الموسم"/>
</Grid>
<WrapPanel HorizontalAlignment="Right" Margin="0,0,0,6"><Button Content="إضافة الموسم" Click="AddSeason_Click" Padding="12,8" Margin="0,0,6,0"/><Button Content="حفظ مسار الموسم المحدد وفحص ملفاته" Click="SaveSeasonFolder_Click" Padding="12,8" Margin="0,0,6,0"/><Button Content="حذف الموسم المحدد" Click="DeleteSeason_Click" Padding="12,8" Background="#FCE8E8" Foreground="#9F2630"/></WrapPanel>
<DataGrid x:Name="SeasonsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="SeasonsGrid_SelectionChanged" CanUserAddRows="False" Height="135" Margin="0,8,0,12">
<DataGrid.Columns><DataGridTextColumn Header="رقم الموسم" Binding="{Binding SeasonNumber}" Width="95"/><DataGridTextColumn Header="اسم الموسم" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="المعرّف" Binding="{Binding SeasonId}" Width="75"/></DataGrid.Columns></DataGrid>
<WrapPanel Margin="0,8"><Button Content="اكتشاف حلقات الموسم" Click="PreviewSeasonFolder_Click" Padding="10,7" Margin="0,0,6,0"/><Button Content="اعتماد ربط الحلقات المحددة" Click="LinkDetectedEpisodes_Click" Padding="10,7"/></WrapPanel>
<DataGrid x:Name="EpisodeCandidatesGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Height="150" Margin="0,0,0,12"><DataGrid.Columns><DataGridCheckBoxColumn Header="ربط" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="48"/><DataGridTextColumn Header="رقم الحلقة" Binding="{Binding EpisodeNumber, UpdateSourceTrigger=PropertyChanged}" Width="85"/><DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" IsReadOnly="True" Width="105"/></DataGrid.Columns></DataGrid>
<Separator/>
<TextBlock Text="إضافة حلقة إلى الموسم المحدد" FontSize="17" FontWeight="Bold" Foreground="#142D4A" Margin="0,12,0,8"/>
<TextBlock Text="ملف الفيديو من المكتبة"/><ComboBox x:Name="EpisodeVideoPicker" DisplayMemberPath="Title" Padding="8" Margin="0,4,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
<TextBox x:Name="EpisodeTitleBox" Grid.Column="0" Padding="8" Margin="0,0,6,8" ToolTip="اسم الحلقة (اختياري)"/>
<TextBox x:Name="EpisodeNumberBox" Grid.Column="1" Padding="8" Margin="0,0,0,8" Text="1" ToolTip="رقم الحلقة"/>
</Grid>
<Button Content="ربط الفيديو كحلقة" Click="AddEpisode_Click" HorizontalAlignment="Right" Padding="12,8"/>
<Separator/>
<WrapPanel Margin="0,10,0,6"><TextBlock Text="الحلقات التي فقدت ملفاتها" FontSize="15" FontWeight="Bold" Foreground="#142D4A" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="فحص الملفات المفقودة" Click="RefreshMissingEpisodes_Click" Padding="10,6"/><Button Content="إعادة ربط الحلقة بالملف المختار" Click="RelinkMissingEpisode_Click" Padding="10,6" Margin="6,0,0,0"/></WrapPanel>
<DataGrid x:Name="MissingEpisodesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="135" Margin="0,0,0,10">
<DataGrid.Columns><DataGridTextColumn Header="المسلسل" Binding="{Binding SeriesTitle}" Width="*"/><DataGridTextColumn Header="الموسم" Binding="{Binding SeasonNumber}" Width="55"/><DataGridTextColumn Header="الحلقة" Binding="{Binding EpisodeNumber}" Width="55"/><DataGridTextColumn Header="اسم الحلقة" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="SeriesStatusText" Text="احفظ المسلسل أولاً، ثم أضف المواسم والحلقات." Foreground="#526174" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="إدارة الأقسام">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="بناء أقسام المكتبة للعميل" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,8"/>
<TextBlock Text="أنشئ قسماً رئيسياً أولاً، ثم أنشئ تحته أقساماً فرعية. لكل قسم غلاف مستقل، ولا يمكن نشر أي قسم قبل رفع غلافه." TextWrapping="Wrap" Foreground="#526174" Margin="0,0,0,12"/>
<TextBlock Text="اسم القسم"/><TextBox x:Name="CategoryTitleBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="القسم الرئيسي الأب (اتركه فارغاً لإنشاء قسم رئيسي)"/><ComboBox x:Name="CategoryParentPicker" DisplayMemberPath="Title" SelectedValuePath="CategoryId" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="نوع القسم"/><ComboBox x:Name="CategoryKindPicker" Padding="8" Margin="0,4,0,8">
<ComboBoxItem Content="قسم رئيسي" Tag="Group" IsSelected="True"/><ComboBoxItem Content="أفلام" Tag="Movie"/><ComboBoxItem Content="مسلسلات" Tag="Series"/><ComboBoxItem Content="محتوى آخر" Tag="Other"/>
</ComboBox>
<TextBlock Text="معرّف القسم (يُنشأ تلقائياً عند تركه فارغاً)"/><TextBox x:Name="CategoryIdBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="مسار الغلاف"/><TextBox x:Name="CategoryPosterPathBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock x:Name="CategoryPosterStatusText" Text="الغلاف إلزامي للنشر." Foreground="#64748B" Margin="0,0,0,8"/>
<WrapPanel Margin="0,0,0,10"><Button Content="حفظ القسم" Click="SaveCategory_Click" Padding="12,8" Background="#C93640" Foreground="White" Margin="0,0,6,0"/><Button Content="رفع غلاف القسم" Click="UploadCategoryPoster_Click" Padding="12,8" Margin="0,0,6,0"/><Button Content="حذف القسم المحدد" Click="DeleteCategory_Click" Padding="12,8" Background="#FCE8E8" Foreground="#9F2630"/></WrapPanel>
<CheckBox x:Name="CategoryPublishBox" Content="نشر القسم للعميل (يتطلب غلافاً)" IsChecked="False" Margin="0,0,0,12"/>
<DataGrid x:Name="CategoriesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CategoriesGrid_SelectionChanged" CanUserAddRows="False" Height="260">
<DataGrid.Columns><DataGridTextColumn Header="القسم" Binding="{Binding DisplayTitle}" Width="*"/><DataGridTextColumn Header="النوع" Binding="{Binding ContentKindLabel}" Width="100"/><DataGridCheckBoxColumn Header="منشور" Binding="{Binding IsPublished}" Width="65"/><DataGridTextColumn Header="الغلاف" Binding="{Binding PosterPath}" Width="*"/></DataGrid.Columns>
</DataGrid>
<TextBlock x:Name="CategoryStatusText" Text="ابدأ بإنشاء قسم رئيسي ثم أضف الأقسام الفرعية." Foreground="#526174" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="رسائل العملاء">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="رسائل العملاء وطلبات المحتوى" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,8"/>
<TextBlock Text="تظهر هنا طلبات المسلسلات وبلاغات المشاكل والاقتراحات التي يرسلها العملاء من صفحة المشاهدة. يتم تحديث القائمة تلقائياً كل 30 ثانية." TextWrapping="Wrap" Foreground="#526174" Margin="0,0,0,10"/>
<WrapPanel Margin="0,0,0,10">
<Button Content="تحديث الرسائل" Click="RefreshCustomerMessages_Click" Padding="12,8" Margin="0,0,6,0"/>
<Button Content="بدء المتابعة" Click="MarkCustomerMessageInProgress_Click" Padding="12,8" Margin="0,0,6,0" Background="#E6F1FA" Foreground="#245B87"/>
<Button Content="تمت المعالجة" Click="ResolveCustomerMessage_Click" Padding="12,8" Margin="0,0,6,0" Background="#E5F4EA" Foreground="#176B3A"/>
<Button Content="حذف الرسالة" Click="DeleteCustomerMessage_Click" Padding="12,8" Background="#FCE8E8" Foreground="#9F2630"/>
</WrapPanel>
<DataGrid x:Name="CustomerMessagesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CustomerMessagesGrid_SelectionChanged" CanUserAddRows="False" Height="280">
<DataGrid.Columns>
<DataGridTextColumn Header="رقم" Binding="{Binding Id}" Width="55"/>
<DataGridTextColumn Header="النوع" Binding="{Binding Category}" Width="110"/>
<DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*"/>
<DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
<DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedUtc}" Width="150"/>
</DataGrid.Columns></DataGrid>
<TextBlock Text="تفاصيل الرسالة المحددة" FontWeight="Bold" Foreground="#142D4A" Margin="0,12,0,5"/>
<Border Background="#F1F5F9" CornerRadius="8" Padding="10"><TextBlock x:Name="CustomerMessageDetailsText" Text="اختر رسالة من القائمة لعرض تفاصيلها." TextWrapping="Wrap" Foreground="#334155"/></Border>
<TextBlock x:Name="CustomerMessageStatusText" Text="لا توجد رسائل محمّلة بعد." Foreground="#526174" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></ScrollViewer></TabItem></TabControl></Border></Grid>
<StackPanel Grid.Row="3"><TextBlock x:Name="AddressBox" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#142D4A"/><TextBlock x:Name="LibraryBox" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4"/><TextBlock x:Name="CountText" FontSize="13" Foreground="#16834A" HorizontalAlignment="Center" Margin="0,4"/><TextBlock Text="المشاهدة متاحة للأجهزة المتصلة بالشبكة المحلية فقط." Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6"/></StackPanel>
</Grid></Window>