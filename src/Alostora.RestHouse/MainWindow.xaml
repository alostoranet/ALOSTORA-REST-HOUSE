<Window x:Class="Alostora.RestHouse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALOSTORA REST HOUSE" Height="760" Width="1120" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FlowDirection="RightToLeft">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#142D4A" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="ALOSTORA REST HOUSE" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="استراحة الأسطورة نت | إدارة مكتبة الأفلام" Foreground="#D7E5F3" FontSize="15" Margin="0,6,0,0"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="ملفات الفيديو في المكتبة" FontSize="18" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,10"/><Button Content="تحديث القائمة" Click="RefreshLibrary_Click" HorizontalAlignment="Right" Padding="14,7" Margin="0,0,0,10"/></StackPanel><DataGrid x:Name="VideosGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="VideosGrid_SelectionChanged" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="اسم الفيديو" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="السنة" Binding="{Binding Year}" Width="65"/><DataGridTextColumn Header="النوع" Binding="{Binding Kind}" Width="85"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18" Margin="8,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="بيانات الفيلم أو المسلسل" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,14"/>
<TextBlock Text="العنوان"/><TextBox x:Name="TitleBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="الوصف"/><TextBox x:Name="DescriptionBox" Padding="8" Margin="0,4,0,10" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<TextBlock Text="سنة الإنتاج"/><TextBox x:Name="YearBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="التصنيف (أكشن، كوميدي...)"/><TextBox x:Name="GenreBox" Padding="8" Margin="0,4,0,10"/>
<TextBlock Text="نوع المحتوى"/><ComboBox x:Name="KindBox" Padding="7" Margin="0,4,0,10"><ComboBoxItem Content="فيلم" Tag="Movie" IsSelected="True"/><ComboBoxItem Content="مسلسل" Tag="Series"/></ComboBox>
<TextBlock Text="معرّف الملف" Foreground="#64748B"/><TextBox x:Name="IdBox" IsReadOnly="True" Padding="8" Margin="0,4,0,14" FlowDirection="LeftToRight"/>
<Button Content="حفظ البيانات" Click="SaveMetadata_Click" Background="#C93640" Foreground="White" FontWeight="Bold" Padding="14,11" BorderThickness="0"/>
<TextBlock x:Name="StatusText" Text="اختر فيديو من القائمة لتعديل بياناته." Foreground="#526174" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></Border></Grid>
<StackPanel Grid.Row="2"><TextBlock x:Name="AddressBox" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#142D4A"/><TextBlock x:Name="LibraryBox" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4"/><TextBlock x:Name="CountText" FontSize="13" Foreground="#16834A" HorizontalAlignment="Center" Margin="0,4"/><TextBlock Text="الكروت والرصيد والتحقق من صلاحية المشترك يديرها MikroTik فقط." Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6"/></StackPanel>
</Grid></Window>