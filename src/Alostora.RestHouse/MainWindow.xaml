</ComboBox>
<TextBlock Text="معرّف القسم (يُنشأ تلقائياً عند تركه فارغاً)"/><TextBox x:Name="CategoryIdBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock Text="مسار الغلاف"/><TextBox x:Name="CategoryPosterPathBox" Padding="8" Margin="0,4,0,8"/>
<TextBlock x:Name="CategoryPosterStatusText" Text="الغلاف اختياري. يمكنك نشر القسم بدونه." Foreground="#64748B" Margin="0,0,0,8"/>
<WrapPanel Margin="0,0,0,10"><Button Content="قسم جديد" Click="NewCategory_Click" Padding="12,8" Margin="0,0,6,0"/><Button Content="حفظ القسم" Click="SaveCategory_Click" Padding="12,8" Background="#C93640" Foreground="White" Margin="0,0,6,0"/><Button Content="نشر القسم المحدد" Click="PublishCategory_Click" Padding="12,8" Background="#E7F5EC" Foreground="#176B3A" Margin="0,0,6,0"/><Button Content="رفع غلاف القسم" Click="UploadCategoryPoster_Click" Padding="12,8" Margin="0,0,6,0"/><Button Content="حذف القسم المحدد" Click="DeleteCategory_Click" Padding="12,8" Background="#FCE8E8" Foreground="#9F2630"/></WrapPanel>
<CheckBox x:Name="CategoryPublishBox" Content="نشر القسم للعميل وإظهاره في الواجهة الرئيسية" IsChecked="True" Margin="0,0,0,12"/>
<DataGrid x:Name="CategoriesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CategoriesGrid_SelectionChanged" CanUserAddRows="False" Height="260">
<DataGrid.Columns><DataGridTextColumn Header="القسم" Binding="{Binding DisplayTitle}" Width="*"/><DataGridTextColumn Header="النوع" Binding="{Binding ContentKindLabel}" Width="100"/><DataGridCheckBoxColumn Header="منشور" Binding="{Binding IsPublished}" Width="65"/><DataGridTextColumn Header="الغلاف" Binding="{Binding PosterPath}" Width="*"/></DataGrid.Columns>
</DataGrid>
<TextBlock x:Name="CategoryStatusText" Text="ابدأ بإنشاء قسم رئيسي ثم أضف الأقسام الفرعية." Foreground="#526174" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="رسائل العملاء">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="رسائل العملاء وطلبات المحتوى" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,8"/>
<TextBlock Text="تظهر هنا طلبات المسلسلات وبلاغات المشاكل والاقتراحات التي يرسلها العملاء من صفحة المشاهدة. يتم تحديث القائمة تلقائياً كل 30 ثانية." TextWrapping="Wrap" Foreground="#526174" Margin="0,0,0,10"/>
<WrapPanel Margin="0,0,0,10">
<Button Content="تحديث الرسائل" Click="RefreshCustomerMessages_Click" Padding="12,8" Margin="0,0,6,0"/>
<Button Content="بدء المتابعة" Click="MarkCustomerMessageInProgress_Click" Padding="12,8" Margin="0,0,6,0" Background="#E6F1FA" Foreground="#245B87"/>
<Button Content="تمت المعالجة" Click="ResolveCustomerMessage_Click" Padding="12,8" Margin="0,0,6,0" Background="#E5F4EA" Foreground="#176B3A"/>
<Button Content="حذف الرسالة" Click="DeleteCustomerMessage_Click" Padding="12,8" Background="#FCE8E8" Foreground="#9F2630"/>
</WrapPanel>
<DataGrid x:Name="CustomerMessagesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="CustomerMessagesGrid_SelectionChanged" MouseDoubleClick="CustomerMessagesGrid_MouseDoubleClick" CanUserAddRows="False" Height="280">
<DataGrid.Columns>
<DataGridTextColumn Header="رقم" Binding="{Binding Id}" Width="55"/>
<DataGridTextColumn Header="النوع" Binding="{Binding Category}" Width="110"/>
<DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*"/>
<DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
<DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedUtc}" Width="150"/>
</DataGrid.Columns></DataGrid>
<TextBlock Text="اضغط على أي رسالة في الجدول لفتح تفاصيلها في نافذة منبثقة وإدارة حالتها." Foreground="#64748B" FontSize="12" Margin="0,8,0,0"/>
<TextBlock x:Name="CustomerMessageStatusText" Text="لا توجد رسائل محمّلة بعد." Foreground="#526174" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="بلاغات الشعارات"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="بلاغات الشعارات والعلامات التجارية" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,8"/><TextBlock Text="تظهر هنا الرسائل التي يرسلها العملاء بخصوص شعار أو علامة تجارية أو الاشتباه في استخدامها دون إذن. اضغط على البلاغ لعرض التفاصيل." Foreground="#526174" TextWrapping="Wrap" Margin="0,0,0,10"/><DataGrid x:Name="LogoReportsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="LogoReportsGrid_SelectionChanged" MouseDoubleClick="LogoReportsGrid_MouseDoubleClick" CanUserAddRows="False" Height="360"><DataGrid.Columns><DataGridTextColumn Header="رقم" Binding="{Binding Id}" Width="60"/><DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedUtc}" Width="150"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></TabItem><TabItem Header="إعدادات التخزين والتشغيل"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="إعدادات متقدمة — لا تحتاج لتغييرها في الاستخدام اليومي" FontSize="18" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,10"/>
<Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="مكان حفظ ملفات الفيديو" FontWeight="Bold" Foreground="#142D4A"/><DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Left" Content="تغيير مجلد التخزين" Click="ChooseMediaFolder_Click" Padding="10,6" Margin="0,0,6,0"/><TextBlock x:Name="MediaFolderBox" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
</StackPanel></Border>
<Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="مكان حفظ أغلفة الصور" FontWeight="Bold" Foreground="#142D4A"/><DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Left" Content="تغيير مجلد الأغلفة" Click="ChoosePostersFolder_Click" Padding="10,6" Margin="0,0,6,0"/><TextBlock x:Name="PostersFolderBox" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
</StackPanel></Border>
<Border Background="#F1F5F9" CornerRadius="8" Padding="12"><StackPanel>
<TextBlock Text="مساعد توافق صيغ الفيديو (FFmpeg) — اختياري" FontWeight="Bold" Foreground="#142D4A"/>
<TextBlock Text="وظيفته تجهيز نسخة تشغيل مؤقتة لبعض الصيغ أو الترميزات التي لا يدعمها المتصفح، وإتاحة اختيار المسار الصوتي واستخراج الترجمة المدمجة. لا يغيّر ملف الفيديو الأصلي. إذا كانت ملفاتك تعمل مباشرة بصيغة MP4 المدعومة، فلست بحاجة إلى ضبطه." Foreground="#526174" TextWrapping="Wrap" Margin="0,5,0,8"/>
<DockPanel><Button DockPanel.Dock="Left" Content="اختيار ffmpeg.exe" Click="ChooseFfmpeg_Click" Padding="10,6" Margin="0,0,6,0"/><Button DockPanel.Dock="Left" Content="حفظ المسار" Click="SaveFfmpeg_Click" Padding="10,6" Margin="0,0,6,0"/><TextBox x:Name="FfmpegPathBox" Padding="7" FlowDirection="LeftToRight" VerticalContentAlignment="Center"/></DockPanel>
<TextBlock x:Name="FfmpegStatusText" Text="ضع ffmpeg.exe وffprobe.exe في المجلد نفسه عند الحاجة إلى التحويل." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
</StackPanel></Border>
</StackPanel></ScrollViewer></TabItem></TabControl></Border></Grid>
<StackPanel Grid.Row="3"><TextBlock x:Name="AddressBox" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#142D4A"/><TextBlock x:Name="LibraryBox" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4"/><TextBlock x:Name="CountText" FontSize="13" Foreground="#16834A" HorizontalAlignment="Center" Margin="0,4"/><TextBlock Text="المشاهدة متاحة للأجهزة المتصلة بالشبكة المحلية فقط." Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6"/></StackPanel>
</Grid></Window>