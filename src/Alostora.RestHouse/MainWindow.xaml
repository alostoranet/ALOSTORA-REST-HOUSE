    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SectionTabBorder" Property="Background" Value="#D6AD58"/><Setter TargetName="SectionTabBorder" Property="BorderBrush" Value="#B98A36"/><Setter Property="Foreground" Value="#142D4A"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
