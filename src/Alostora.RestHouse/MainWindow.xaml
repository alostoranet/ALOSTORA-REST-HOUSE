 <Border Background="#E8EEF5" CornerRadius="10" Padding="16" Margin="4"><StackPanel><TextBlock Text="الفيديوهات المنشورة" Foreground="#526174" FontSize="12"/><TextBlock x:Name="DashboardPublishedCount" Text="—" Foreground="#16834A" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
 <Border Background="#E8EEF5" CornerRadius="10" Padding="16" Margin="4"><StackPanel><TextBlock Text="الصوتيات والكتب والتطبيقات" Foreground="#526174" FontSize="12"/><TextBlock x:Name="DashboardMediaCount" Text="—" Foreground="#245B87" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
</UniformGrid></StackPanel></TabItem>
