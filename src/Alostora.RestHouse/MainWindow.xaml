<Button Content="للأعلى" Click="MoveCustomerAdUp_Click" Padding="10,7" Margin="0,0,6,6"/>
<Button Content="للأسفل" Click="MoveCustomerAdDown_Click" Padding="10,7" Margin="0,0,6,6"/>
<Button Content="حذف الصورة المحددة" Click="DeleteCustomerAd_Click" Padding="10,7" Margin="0,0,6,6"/>
<Button Content="تحديث القائمة" Click="LoadCustomerAds_Click" Padding="10,7" Margin="0,0,6,6"/>
</WrapPanel>
