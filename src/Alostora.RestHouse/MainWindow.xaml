<Button Content="فحص الكتب" Click="ScanBooksLibrary_Click" Padding="13,8" Margin="0,0,7,6" Background="#E7F5EC"/>
<Button Content="فحص التطبيقات" Click="ScanAppsLibrary_Click" Padding="13,8" Margin="0,0,7,6" Background="#E7F5EC"/>
<Button Content="تحديث القائمة" Click="RefreshMultiMediaLibrary_Click" Padding="13,8" Margin="0,0,7,6"/>
</WrapPanel>
<TextBlock x:Name="MultiMediaLibraryStatusText" Text="لم يتم فحص المكتبات بعد." Foreground="#526174" Margin="0,0,0,8"/>
</StackPanel>
