<Window x:Class="Alostora.RestHouse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALOSTORA REST HOUSE" Height="600" Width="900" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FlowDirection="RightToLeft"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#142D4A" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="ALOSTORA REST HOUSE" Foreground="White" FontSize="26" FontWeight="Bold"/><TextBlock Text="استراحة الأسطورة نت | لوحة إدارة المكتبة" Foreground="#D7E5F3" FontSize="16" Margin="0,8,0,0"/></StackPanel></Border><StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="14"><TextBlock Text="السيرفر يعمل" Foreground="#16834A" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="رابط المشاهدة للمشتركين" FontSize="16" HorizontalAlignment="Center" Margin="0,18,0,7"/><TextBox x:Name="AddressBox" IsReadOnly="True" FontSize="18" Padding="10" TextAlignment="Center"/><TextBlock Text="مجلد مكتبة الفيديو" FontSize="16" Margin="0,22,0,7"/><TextBox x:Name="LibraryBox" IsReadOnly="True" Padding="10"/><TextBlock x:Name="CountText" Text="عدد ملفات الفيديو: ..." FontSize="17" FontWeight="Bold" Foreground="#142D4A" Margin="0,16,0,10" HorizontalAlignment="Center"/><WrapPanel HorizontalAlignment="Center"><Button Content="فتح مجلد المكتبة" Click="OpenLibrary_Click" Background="#142D4A" Foreground="White" Padding="18,10" Margin="5" BorderThickness="0"/><Button Content="فحص المكتبة وتحديث العدد" Click="RefreshLibrary_Click" Background="#C93640" Foreground="White" Padding="18,10" Margin="5" BorderThickness="0"/></WrapPanel><TextBlock Text="ضع ملفات MP4 أو M4V أو WebM داخل المجلد، ويمكنك تنظيمها في مجلدات فرعية." Foreground="#526174" Margin="0,16,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/></StackPanel><TextBlock Grid.Row="2" Text="الكروت والرصيد والتحقق من صلاحية المشترك يديرها MikroTik فقط." Foreground="#64748B" HorizontalAlignment="Center"/></Grid></Window>