   <Setter Property="Background" Value="#E8EEF5"/><Setter Property="Foreground" Value="#334155"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
