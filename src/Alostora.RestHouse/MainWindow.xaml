<WrapPanel Margin="0,0,0,10"><Button Content="حفظ تعديل الحلقة المحددة" Click="UpdateEpisode_Click" Padding="10,7" Margin="0,0,6,0"/><Button Content="فك ربط الحلقة المحددة فقط" Click="UnlinkEpisode_Click" Padding="10,7" Background="#FCE8E8" Foreground="#9F2630"/></WrapPanel>
<WrapPanel Margin="0,8"><Button Content="اكتشاف حلقات الموسم" Click="PreviewSeasonFolder_Click" Padding="10,7" Margin="0,0,6,0"/><Button Content="اعتماد ربط الحلقات المحددة" Click="LinkDetectedEpisodes_Click" Padding="10,7"/></WrapPanel>
<DataGrid x:Name="EpisodeCandidatesGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" Height="150" Margin="0,0,0,12"><DataGrid.Columns><DataGridCheckBoxColumn Header="ربط" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="48"/><DataGridTextColumn Header="رقم الحلقة" Binding="{Binding EpisodeNumber, UpdateSourceTrigger=PropertyChanged}" Width="85"/><DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" IsReadOnly="True" Width="105"/></DataGrid.Columns></DataGrid>
<Separator/>
<TextBlock Text="إضافة حلقة إلى الموسم المحدد" FontSize="17" FontWeight="Bold" Foreground="#142D4A" Margin="0,12,0,8"/>
<TextBlock Text="ملف الفيديو من المكتبة"/><ComboBox x:Name="EpisodeVideoPicker" DisplayMemberPath="Title" Padding="8" Margin="0,4,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
<TextBox x:Name="EpisodeTitleBox" Grid.Column="0" Padding="8" Margin="0,0,6,8" ToolTip="اسم الحلقة (اختياري)"/>
<TextBox x:Name="EpisodeNumberBox" Grid.Column="1" Padding="8" Margin="0,0,0,8" Text="1" ToolTip="رقم الحلقة"/>
</Grid>
<Button Content="ربط الفيديو كحلقة" Click="AddEpisode_Click" HorizontalAlignment="Right" Padding="12,8"/></StackPanel>
<Separator/>
<WrapPanel Margin="0,10,0,6"><TextBlock Text="الحلقات التي فقدت ملفاتها" FontSize="15" FontWeight="Bold" Foreground="#142D4A" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="فحص الملفات المفقودة" Click="RefreshMissingEpisodes_Click" Padding="10,6"/><Button Content="إعادة ربط الحلقة بالملف المختار" Click="RelinkMissingEpisode_Click" Padding="10,6" Margin="6,0,0,0"/></WrapPanel>
<DataGrid x:Name="MissingEpisodesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="135" Margin="0,0,0,10">
<DataGrid.Columns><DataGridTextColumn Header="المسلسل" Binding="{Binding SeriesTitle}" Width="*"/><DataGridTextColumn Header="الموسم" Binding="{Binding SeasonNumber}" Width="55"/><DataGridTextColumn Header="الحلقة" Binding="{Binding EpisodeNumber}" Width="55"/><DataGridTextColumn Header="اسم الحلقة" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="SeriesStatusText" Text="احفظ المسلسل أولاً، ثم أضف المواسم والحلقات." Foreground="#526174" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="إدارة الأقسام">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="بناء أقسام المكتبة للعميل" FontSize="19" FontWeight="Bold" Foreground="#142D4A" Margin="0,0,0,8"/>
<TextBlock Text="أنشئ قسماً رئيسياً أولاً، ثم أضف تحته أقسام الأفلام أو المسلسلات. القسم المنشور يظهر للعميل مباشرة، والغلاف اختياري ويمكن رفعه لاحقاً." TextWrapping="Wrap" Foreground="#526174" Margin="0,0,0,12"/>
<TextBlock Text="اسم القسم"/><TextBox x:Name="CategoryTitleBox" Padding="8" Margin="0,4,0,8"/>
